{
  "name": "@drahamo/tiling-layout",
  "version": "0.1.0",
  "description": "网格分割布局的 React 库：分割/合并/停靠/调大小 + 纯数据管理层",
  "license": "MIT",
  "author": "Hamo <190395489@qq.com>",
  "keywords": [
    "react",
    "layout",
    "tiling",
    "split",
    "join",
    "dock",
    "docking",
    "resizable",
    "panel",
    "grid-layout"
  ],
  "type": "module",
  "main": "dist/tiling-layout.cjs",
  "module": "dist/tiling-layout.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/tiling-layout.mjs",
      "require": "./dist/tiling-layout.cjs"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "docs": "npm --prefix docs run build",
    "docs:start": "npm --prefix docs run start",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "zustand": ">=4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.8",
    "zustand": "^4.5.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamo-reid/tiling-layout.git"
  },
  "homepage": "https://hamo-reid.github.io/tiling-layout/",
  "bugs": {
    "url": "https://github.com/hamo-reid/tiling-layout/issues"
  }
}
